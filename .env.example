# ============================================================
# FinSentiMind — Environment Variables Template
# ============================================================
# Cara pakai:
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
#   lalu isi nilai-nilai di bawah
# ============================================================


# ------------------------------------------------------------
# REQUIRED — Supabase (database)
# ------------------------------------------------------------
# Ambil dari: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here


# ------------------------------------------------------------
# OPTIONAL — Telegram scraper
# ------------------------------------------------------------
# Kosongkan kalau tidak dipakai.
# Ambil dari: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=


# ------------------------------------------------------------
# OPTIONAL — Stockbit scraper
# ------------------------------------------------------------
STOCKBIT_BEARER_TOKEN=


# ------------------------------------------------------------
# OPTIONAL — Logging
# ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO